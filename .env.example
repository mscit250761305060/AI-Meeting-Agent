# ==============================================================================
# AI Meeting Agent Configuration Environment Template
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Database Configuration
# Default is local SQLite: sqlite:///ai_meeting_agent.db
# For PostgreSQL in production, use: postgresql://user:password@localhost:5432/meeting_agent
AGENT_DATABASE_URL=sqlite:///ai_meeting_agent.db

# Authentication & Session Security
# Generate a strong 32+ character random string for production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-in-production-use-a-strong-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth 2.0 Credentials (Optional / Per-User Google Account Connection)
# Obtain from Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI must match: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Meeting Browser Playwright Settings
# Set to true for headless background mode (default: false so the browser window is visible for authentication/admission)
HEADLESS_MEETING=false

# Central AI Configuration & LLM Provider Keys
# Local Ollama engine (Recommended for offline summarization & action item extraction)
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen2.5-coder:7b

# Legacy / Cloud LLM API Keys (Optional fallbacks)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
