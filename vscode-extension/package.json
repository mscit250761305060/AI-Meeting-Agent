{
  "name": "ai-meeting-agent",
  "displayName": "AI Meeting Agent",
  "description": "AI Meeting Agent developer assistant",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-meeting-agent.start",
        "title": "Start AI Meeting Agent"
      },
      {
        "command": "ai-meeting-agent.generateProject",
        "title": "Generate Project"
      },
      {
        "command": "ai-meeting-agent.updateProject",
        "title": "Update Project"
      },
      {
        "command": "ai-meeting-agent.fixErrors",
        "title": "Fix Errors"
      },
      {
        "command": "ai-meeting-agent.runProject",
        "title": "Run Project"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-meeting-agent",
          "title": "AI Agent"
        }
      ]
    },
    "views": {
      "ai-meeting-agent": [
        {
          "type": "webview",
          "id": "ai-meeting-agent.sidebar",
          "name": "AI Meeting Agent"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.74.0",
    "@types/ws": "^8.5.4",
    "typescript": "^5.3.3"
  }
}
